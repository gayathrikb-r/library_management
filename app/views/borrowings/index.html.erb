<h1>📖 Borrowings</h1>

<div data-controller="borrowings" 
     data-borrowings-filter-value="<%= params[:filter] %>"
     data-borrowings-member-id-value="<%= params[:member_id] %>">
  
  <% if librarian_signed_in? %>
    <div class="card" style="margin-bottom: 15px;">
      <div style="display: flex; gap: 10px;">
        <button class="btn <%= params[:filter].nil? ? 'btn-success' : '' %>" 
                data-action="click->borrowings#setFilter" 
                data-filter="">
          All
        </button>
        <button class="btn <%= params[:filter] == 'active' ? 'btn-success' : '' %>" 
                data-action="click->borrowings#setFilter" 
                data-filter="active">
          Active
        </button>
        <button class="btn <%= params[:filter] == 'overdue' ? 'btn-success' : '' %>" 
                data-action="click->borrowings#setFilter" 
                data-filter="overdue">
          Overdue
        </button>
        <button class="btn <%= params[:filter] == 'returned' ? 'btn-success' : '' %>" 
                data-action="click->borrowings#setFilter" 
                data-filter="returned">
          Returned
        </button>
      </div>
    </div>
  <% end %>

  <div class="card" data-borrowings-target="table">
    <!-- Borrowings will be loaded here -->
  </div>
</div>

<style>
  .table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .table th,
  .table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  
  .table th {
    background-color: #f8f9fa;
    font-weight: bold;
  }
  
  .table-striped tbody tr:nth-of-type(odd) {
    background-color: #f9f9f9;
  }
  
  .action-buttons {
    display: flex;
    gap: 5px;
  }
</style>