<div class="card">
  <h1>Edit Book</h1>

  <div data-controller="book-form" 
       data-book-form-book-id-value="<%= @book.id %>"
       data-book-form-is-edit-value="true">
    
    <div data-book-form-target="errors"></div>
    
    <form data-action="submit->book-form#submit">
      <div class="form-group">
        <label>Title *</label>
        <input type="text" name="book[title]" value="<%= @book.title %>" required class="form-control">
      </div>

      <div class="form-group">
        <label>ISBN</label>
        <input type="text" name="book[isbn]" value="<%= @book.isbn %>" class="form-control">
      </div>

      <div class="form-group">
        <label>Publication Year</label>
        <input type="number" name="book[publication_year]" value="<%= @book.publication_year %>" class="form-control">
      </div>

      <div class="form-group">
        <label>Total Copies</label>
        <input type="number" name="book[total_copies]" value="<%= @book.total_copies %>" min="0" class="form-control">
      </div>

      <div class="form-group">
        <label>Available Copies</label>
        <input type="number" name="book[available_copies]" value="<%= @book.available_copies %>" min="0" class="form-control">
      </div>

      <div class="form-group">
        <label>Description</label>
        <textarea name="book[description]" rows="4" class="form-control"><%= @book.description %></textarea>
      </div>

      <div class="form-group">
        <label style="font-weight: bold; margin-bottom: 10px; display: block;">Authors</label>

        <div style="background: #f9f9f9; padding: 15px; border-radius: 4px; margin-bottom: 10px;">
          <p style="margin-bottom: 10px; font-weight: bold; color: #555;">Select Existing Authors:</p>

          <div class="checkbox-group">
            <% Author.order(:name).each do |author| %>
              <div class="checkbox-item">
                <input type="checkbox" 
                       name="book[author_ids][]" 
                       value="<%= author.id %>" 
                       id="author_<%= author.id %>"
                       <%= 'checked' if @book.author_ids.include?(author.id) %>>
                <label for="author_<%= author.id %>"><%= author.name %></label>
              </div>
            <% end %>
          </div>
        </div>

        <div style="background: #e7f3ff; padding: 15px; border-radius: 4px; border: 2px solid #007bff;">
          <p style="font-weight: bold; color: #007bff;">Add New Authors:</p>
          <input type="text" name="book[new_author_name]"
                 placeholder="Comma separated (e.g. John Smith, Jane Doe)"
                 style="width:100%; padding:10px;">
        </div>
      </div>

      <div class="form-group">
        <label style="font-weight: bold; margin-bottom: 10px; display: block;">Categories</label>

        <div style="background: #f9f9f9; padding: 15px; border-radius: 4px; margin-bottom: 10px;">
          <p style="margin-bottom: 10px; font-weight: bold; color: #555;">Select Existing Categories:</p>

          <div class="checkbox-group">
            <% Category.order(:name).each do |category| %>
              <div class="checkbox-item">
                <input type="checkbox" 
                       name="book[category_ids][]" 
                       value="<%= category.id %>" 
                       id="category_<%= category.id %>"
                       <%= 'checked' if @book.category_ids.include?(category.id) %>>
                <label for="category_<%= category.id %>"><%= category.name %></label>
              </div>
            <% end %>
          </div>
        </div>

        <div style="background: #fff3e0; padding: 15px; border-radius: 4px; border: 2px solid #ff9800;">
          <p style="font-weight: bold; color: #ff9800;">Add New Categories:</p>
          <input type="text" name="book[new_category_name]"
                 placeholder="Comma separated (e.g. Mystery, Thriller)"
                 style="width:100%; padding:10px;">
        </div>
      </div>

      <button type="submit" class="btn">Update Book</button>
      <%= link_to "Cancel", @book, class: "btn btn-secondary" %>
    </form>
  </div>
</div>

