<div 
  data-controller="book-show" 
  data-book-show-book-id-value="<%= @book.id %>"
  data-member-signed-in="<%= member_signed_in? %>"
  data-librarian-signed-in="<%= librarian_signed_in? %>"
  data-current-member-id="<%= current_member&.id %>">
  
  <div class="card" data-book-show-target="bookDetails">
    <!-- Book details will be loaded here -->
  </div>

  <div class="card" data-book-show-target="reviewsList">
    <!-- Reviews will be loaded here -->
  </div>
</div>

<style>
  .form-control {
    width: 100%;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

  .form-group {
    margin-bottom: 15px;
  }

  .star-rating {
    color: #f39c12;
  }

  .review-card {
    border: 1px solid #ddd;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 4px;
  }

  .review-date {
    color: #666;
    font-size: 0.9em;
  }

  .action-row {
    margin-top: 20px;
  }
</style>