<div class="header-section">
  <h1>📚 Book Catalog</h1>
</div>

<div data-controller="books">
  <!-- Filters -->
  <div class="card">
    <form data-action="submit->books#search" class="filter-form">
      <div class="filter-row">
        <input 
          type="text"
          name="search"
          data-books-target="search"
          placeholder="Search by title or ISBN"
          class="filter-input search-main">

        <select 
          name="category_id"
          data-books-target="category"
          class="filter-input">
          <option value="">All Categories</option>
          <% Category.order(:name).each do |category| %>
            <option value="<%= category.id %>"><%= category.name %></option>
          <% end %>
        </select>

        <select 
          name="available"
          data-books-target="available"
          class="filter-input">
          <option value="">All Books</option>
          <option value="true">Available Only</option>
        </select>

        <button type="submit" class="btn btn-primary">Search</button>
        <button type="button" data-action="click->books#clear" class="btn btn-secondary">Clear</button>
      </div>
    </form>
  </div>

  <!-- Librarian-only action -->
  <% if librarian_signed_in? %>
    <div class="actions-bar">
      <%= link_to "➕ Add New Book", new_book_path, class: "btn btn-success" %>
    </div>
  <% end %>

  <!-- Books Grid -->
  <div class="grid" data-books-target="grid">
    <!-- Books will be loaded here via JavaScript -->
  </div>
  <div data-books-target="pagination"></div>
</div>