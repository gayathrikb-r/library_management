<h1>Authors</h1>

<div data-controller="authors">
  <div class="card">
    <form data-action="submit->authors#search">
      <div style="display: flex; gap: 10px;">
        <input 
          type="text"
          name="search"
          data-authors-target="search"
          placeholder="Search authors..."
          style="flex: 1;">
        <button type="submit" class="btn">Search</button>
        <button type="button" data-action="click->authors#clear" class="btn btn-secondary">Clear</button>
      </div>
    </form>
  </div>

  <% if librarian_signed_in? %>
    <%= link_to "➕ Add New Author", new_author_path, class: "btn btn-success mb-20" %>
  <% end %>

  <div class="grid" data-authors-target="grid">
    <!-- Authors will be loaded here via JavaScript -->
  </div>

  <div data-authors-target="pagination"></div>
</div>