<div 
  data-controller="author-show" 
  data-author-show-author-id-value="<%= @author.id %>"
  data-member-signed-in="<%= member_signed_in? %>"
  data-librarian-signed-in="<%= librarian_signed_in? %>"
  data-current-member-id="<%= current_member&.id %>">
  
  <div class="card" data-author-show-target="authorDetails">
    <!-- Author details will be loaded here -->
  </div>

  <div class="card" data-author-show-target="reviewsList">
    <!-- Reviews will be loaded here -->
  </div>
</div>

<style>
  .form-group {
    margin-bottom: 15px;
  }

  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

  .star-rating {
    color: #f39c12;
  }

  .review-card {
    border: 1px solid #ddd;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 4px;
  }

  .review-date {
    color: #666;
    font-size: 0.9em;
  }
</style>