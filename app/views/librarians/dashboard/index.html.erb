<h1>📊 Librarian Dashboard</h1>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;">
  <div class="card">
    <h3>Total Books</h3>
    <p style="font-size: 2em; font-weight: bold; color: #007bff;"><%= @total_books %></p>
  </div>

  <div class="card">
    <h3>Total Members</h3>
    <p style="font-size: 2em; font-weight: bold; color: #28a745;"><%= @total_members %></p>
  </div>

  <div class="card">
    <h3>Active Borrowings</h3>
    <p style="font-size: 2em; font-weight: bold; color: #17a2b8;"><%= @active_borrowings %></p>
  </div>

  <div class="card">
    <h3>Overdue Books</h3>
    <p style="font-size: 2em; font-weight: bold; color: #dc3545;"><%= @overdue_borrowings %></p>
  </div>

  <div class="card">
    <h3>Pending Reservations</h3>
    <p style="font-size: 2em; font-weight: bold; color: #ffc107;"><%= @pending_reservations %></p>
  </div>

  <div class="card">
    <h3>Pending Reviews</h3>
    <p style="font-size: 2em; font-weight: bold; color: #6c757d;"><%= @pending_reviews %></p>
  </div>
</div>

<hr>

<div class="card">
  <h2>⚠️ Overdue Books</h2>

  <% if @overdue_books.any? %>
    <table>
      <thead>
        <tr>
          <th>Member</th>
          <th>Book</th>
          <th>Due Date</th>
          <th>Days Overdue</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @overdue_books.each do |borrowing| %>
          <tr>
            <td><%= borrowing.member.name %></td>
            <td><%= borrowing.book.title %></td>
            <td><%= borrowing.due_date.strftime("%b %d, %Y") %></td>
            <td>
              <span class="badge badge-danger">
                <%= borrowing.days_overdue %> days
              </span>
            </td>
            <td>
              <%= link_to "View", borrowing, class: "btn" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>No overdue books! 🎉</p>
  <% end %>
</div>

<hr>

<div class="card">
  <h2>📚 Recent Borrowings</h2>

  <table>
    <thead>
      <tr>
        <th>Member</th>
        <th>Book</th>
        <th>Borrowed On</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @recent_borrowings.each do |borrowing| %>
        <tr>
          <td><%= borrowing.member.name %></td>
          <td><%= borrowing.book.title %></td>
          <td><%= borrowing.created_at.strftime("%b %d, %Y") %></td>
          <td>
            <% if borrowing.active? %>
              <span class="badge badge-info">Active</span>
            <% elsif borrowing.overdue? %>
              <span class="badge badge-danger">Overdue</span>
            <% else %>
              <span class="badge badge-success">Returned</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<hr>

<div style="margin-top: 20px;">
  <%= link_to "➕ Add New Book", new_book_path, class: "btn", style: "background: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; display: inline-block;" %>
  <%= link_to "📚 Manage Books", books_path, class: "btn", style: "background: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; display: inline-block; margin-left: 10px;" %>
</div>