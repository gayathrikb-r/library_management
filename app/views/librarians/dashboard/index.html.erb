<div data-controller="librarian-dashboard">
  <h1>📊 Librarian Dashboard</h1>

  <!-- Stats Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px;" 
       data-librarian-dashboard-target="stats">
    <!-- Stats will be loaded here -->
  </div>

  <hr>

  <!-- Overdue Books Section -->
  <div class="card">
    <h2>⚠️ Overdue Books</h2>
    <div data-librarian-dashboard-target="overdueBooks">
      <!-- Overdue books will be loaded here -->
    </div>
  </div>

  <hr>

  <!-- Pending Reviews Section -->
  <div class="card">
    <h2>📝 Pending Reviews</h2>
    <div data-librarian-dashboard-target="pendingReviews">
      <!-- Pending reviews will be loaded here -->
    </div>
  </div>

  <hr>

  <!-- Recent Borrowings Section -->
  <div class="card">
    <h2>📚 Recent Borrowings</h2>
    <div data-librarian-dashboard-target="recentBorrowings">
      <!-- Recent borrowings will be loaded here -->
    </div>
  </div>

  <hr>

  <!-- Pending Reservations Section -->
  <div class="card">
    <h2>📌 Pending Reservations</h2>
    <div data-librarian-dashboard-target="pendingReservations">
      <!-- Pending reservations will be loaded here -->
    </div>
  </div>

  <hr>

  <!-- Quick Actions -->
  <div style="margin-top: 20px;">
    <%= link_to "➕ Add New Book", new_book_path, class: "btn", 
        style: "background: #007bff; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; display: inline-block;" %>
    <%= link_to "📚 Manage Books", books_path, class: "btn", 
        style: "background: #6c757d; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px; display: inline-block; margin-left: 10px;" %>
  </div>
</div>

<style>
  .action-buttons {
    display: flex;
    gap: 10px;
  }
  
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  
  th, td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  
  th {
    background-color: #f8f9fa;
    font-weight: bold;
  }
  
  .badge {
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85em;
    font-weight: bold;
  }
  
  .badge-success {
    background-color: #28a745;
    color: white;
  }
  
  .badge-danger {
    background-color: #dc3545;
    color: white;
  }
  
  .badge-info {
    background-color: #17a2b8;
    color: white;
  }
  
  .badge-warning {
    background-color: #ffc107;
    color: #000;
  }
</style>