<div class="auth-signupandlogin">
  <h2 class="auth-title">
  <%= resource_name == :member ? "Log in as Member" : "Log in as Librarian" %>
</h2>

  <%= form_for(resource,
               as: resource_name,
               url: session_path(resource_name),
               html: { class: "auth-form" }) do |f| %>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email,
            class: "form-control",
            autofocus: true,
            autocomplete: "email" %>
    </div>

    <div class="form-group">
      <%= f.label :password %>
      <%= f.password_field :password,
            class: "form-control",
            autocomplete: "current-password" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="form-group remember-me">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="form-actions">
      <%= f.submit "Log in", class: "btn-primary" %>
    </div>
  <% end %>

  <div class="auth-links">
    <%= render "devise/shared/links" %>
  </div>
</div>

