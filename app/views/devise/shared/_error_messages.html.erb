<% if resource.errors.any? %>
  <div class="devise-errors">
    <h4><%= pluralize(resource.errors.count, "error") %> prohibited this <%= resource_name.to_s.humanize.downcase %> from being saved:</h4>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
