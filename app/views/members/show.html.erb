<h1>👤 My Profile</h1>

<div data-controller="member-profile" 
     data-member-profile-member-id-value="<%= @member.id %>"
     data-member-signed-in="<%= member_signed_in? %>"
     data-librarian-signed-in="<%= librarian_signed_in? %>"
     data-current-member-id="<%= current_member&.id %>">
  
  <div class="card" data-member-profile-target="profile">
    <!-- Profile details will be loaded here -->
  </div>

  <!-- LIBRARIAN VIEW -->
  <% if librarian_signed_in? %>
    <div class="card" data-member-profile-target="activity">
      <!-- Activity stats will be loaded here -->
    </div>
  <% end %>

  <div style="margin-top: 15px;">
    <%= link_to "⬅ Back", root_path, class: "btn btn-light" %>
  </div>
</div>