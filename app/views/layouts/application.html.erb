<!DOCTYPE html>
<html>
  <head>
    <title>Library Management System</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "application_custom", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header>
      <nav>
      <div>
        <%= link_to "📚 Library", root_path, style: "font-size: 1.5em; font-weight: bold;" %>
        <%= link_to "Books", books_path %>
        <%= link_to "Authors", authors_path %>
        <%= link_to "Categories", categories_path %>
      </div>

      <div>
        <% if member_signed_in? %>
        <span style="color: #fff; margin-right: 10px;">
          Hello, <%= current_member.name || current_member.email %>
        </span>
        <%= link_to "My Borrowings", borrowings_path %>
        <%= link_to "My Reservations", reservations_path %>
        <%= link_to "Logout", destroy_member_session_path,
                    method: :delete,
                    data: { turbo_method: :delete } %>
      <% elsif librarian_signed_in? %>
        <span style="color: #fff; margin-right: 10px;">
          Hello, <%= current_librarian.name || current_librarian.email %>
        </span>
        <%= link_to "Admin Dashboard", admin_root_path %>
        <%= link_to "Logout", destroy_librarian_session_path,
                    method: :delete,
                    data: { turbo_method: :delete } %>
      <% else %>
        <%= link_to "Login", login_path %>
        <%= link_to "Sign Up", sign_up_path %>
      <% end %>

      </div>
    </nav>

    </header>

    <div class="container">
      <% if flash[:notice] %>
        <div class="flash notice"><%= flash[:notice] %></div>
      <% end %>
      
      <% if flash[:alert] %>
        <div class="flash alert"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>