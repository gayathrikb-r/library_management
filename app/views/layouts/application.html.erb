<!DOCTYPE html>
<html>
  <head>
    <title>Library Management System</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <meta name="api-token" content="<%= current_api_token %>">

    <% unless request.path.start_with?('/admin') %>
      <%= stylesheet_link_tag "application_custom", "data-turbo-track": "reload" %>
    <% end %>
    
    <% if devise_controller? %>
      <%= stylesheet_link_tag "login", media: "all" %>
      <%= stylesheet_link_tag "devise_forgot_password", media: "all" %>
      <%= stylesheet_link_tag "devise_login", media: "all" %>
      <%= stylesheet_link_tag "devise_errors", media: "all" %>
    <% end %>

    <%= javascript_importmap_tags %>
  </head>

  <body 
  data-controller="auth-bridge"
  data-member-signed-in="<%= member_signed_in? %>"
  data-librarian-signed-in="<%= librarian_signed_in? %>"
  data-current-member-id="<%= current_member&.id %>">

    <header>
      <nav>
        <div>
          <%= link_to "📚 Library", root_path, style: "font-size: 1.5em; font-weight: bold;" %>
          <%= link_to "Books", books_path %>
          <%= link_to "Authors", authors_path %>
          <%= link_to "Categories", categories_path %>
        </div>

        <div>
          <% if member_signed_in? %>
   
            <%= link_to "Hello, #{current_member.name || current_member.email}",
                member_path(current_member),
                style: "color: #fff; margin-right: 10px; text-decoration: none;" %>

            <%= link_to "My Borrowings", borrowings_path %>
            <%= link_to "My Reservations", reservations_path %>
          <%= link_to "Logout", destroy_member_session_path, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>

          <% elsif librarian_signed_in? %>
          <span style="color: #fff; margin-right: 10px;">
            Hello, <%= current_librarian.name || current_librarian.email %>
          </span>

          <%= link_to "Dashboard", librarians_dashboard_path %>
          <%= link_to "Borrowings", borrowings_path %>
          <%= link_to "Reservations", librarians_reservations_path %>

          <%= link_to "Logout",
              destroy_librarian_session_path,
              data: { turbo_method: :delete } %>
          <% elsif admin_user_signed_in? %>
            <%= link_to "Admin Panel", admin_root_path %>

          <% else %>
            <%= link_to "Login", login_path %>
            <%= link_to "Sign Up", new_member_registration_path %>
          <% end %>
        </div>
      </nav>
    </header>

<div class="container">
  <% flash.each do |key, message| %>
    <% unless message.is_a?(Array) %> 
      <div class="flash <%= key %>">
        <%= message %>
      </div>
    <% end %>
  <% end %>

  <%= yield %>
</div>
  </body>
</html>