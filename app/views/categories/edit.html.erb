<div class="card">
  <h1>Edit Category</h1>

  <div data-controller="category-form" 
       data-category-form-category-id-value="<%= @category.id %>"
       data-category-form-is-edit-value="true">
    
    <div data-category-form-target="errors"></div>
    
    <form data-action="submit->category-form#submit">
      <div class="form-group">
        <label>Name *</label>
        <input type="text" name="category[name]" value="<%= @category.name %>" required>
      </div>

      <button type="submit" class="btn">Update Category</button>
      <%= link_to "Cancel", categories_path, class: "btn btn-secondary" %>
    </form>
  </div>
</div>