<div class="card">
  <h1>Add New Category</h1>

  <div data-controller="category-form" data-category-form-is-edit-value="false">
    <div data-category-form-target="errors"></div>
    
    <form data-action="submit->category-form#submit">
      <div class="form-group">
        <label>Name *</label>
        <input type="text" name="category[name]" required>
      </div>

      <button type="submit" class="btn">Create Category</button>
      <%= link_to "Cancel", categories_path, class: "btn btn-secondary" %>
    </form>
  </div>
</div>

<style>
  .form-group {
    margin-bottom: 15px;
  }

  .form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
  }

  .form-group input {
    width: 100%;
    padding: 8px;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
</style>