<div data-controller="member-dashboard" data-member-dashboard-member-name-value="<%= @member.name %>">
  <h1>Welcome, <%= @member.name %>! 📚</h1>

  <div class="card">
    <h2>Active Borrowings</h2>
    <div data-member-dashboard-target="borrowings">
      <!-- Borrowings will be loaded here -->
    </div>
  </div>

  <div class="card">
    <h2>My Reservations</h2>
    <div data-member-dashboard-target="reservations">
      <!-- Reservations will be loaded here -->
    </div>
  </div>

  <div class="card">
    <h2>My Recent Reviews</h2>
    <div data-member-dashboard-target="reviews">
      <!-- Reviews will be loaded here -->
    </div>
  </div>
</div>

<style>
  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 15px;
  }
  
  th, td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #ddd;
  }
  
  th {
    background-color: #f8f9fa;
    font-weight: bold;
  }
  
  .star-rating {
    color: #f39c12;
  }
</style>