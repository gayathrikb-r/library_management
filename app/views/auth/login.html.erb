<div class="login-wrapper" data-controller="login-cards">
  <div class="login-container">

    <h1 class="login-title">Login to Library 📚</h1>

    <div class="login-cards">

      <div class="login-card" data-action="mouseenter->login-cards#highlight mouseleave->login-cards#reset">
        <h2>👤 Member</h2>
        <p>Borrow books</p>
        <%= link_to "Login as Member",
            new_member_session_path,
            class: "btn btn-primary" %>
      </div>

      <div class="login-card" data-action="mouseenter->login-cards#highlight mouseleave->login-cards#reset">
        <h2>👨‍💼 Librarian</h2>
        <p>Manage library system</p>
        <%= link_to "Login as Librarian",
            new_librarian_session_path,
            class: "btn btn-secondary" %>
      </div>

    </div>
  </div>
</div>
